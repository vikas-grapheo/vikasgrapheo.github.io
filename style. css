
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
  --bg: #080808;
  --surface: #141414;
  --gold: #e9b949;
  --white: #f5f3ed;
  --muted: #999;
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html { scroll-behavior: smooth; }

body {
  background: var(--bg);
  color: var(--white);
  font-family: 'DM Sans', sans-serif;
}

a { text-decoration: none; color: inherit; }

header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(8,8,8,.95);
  border-bottom: 1px solid #292929;
  padding: 22px 7%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.logo {
  font: 700 23px 'Space Grotesk';
  color: var(--gold);
  letter-spacing: -1px;
}

nav {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
}

nav a {
  font-size: 13px;
  color: #bbb;
  transition: .3s;
}

nav a:hover, nav a.active {
  color: var(--gold);
}

.hero {
  min-height: 82vh;
  padding: 100px 8%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background:
    radial-gradient(ellipse at 85% 20%, #392b12, transparent 38%),
    #080808;
}

.eyebrow {
  color: var(--gold);
  letter-spacing: 4px;
  font-size: 11px;
  font-weight: 700;
  margin-bottom: 25px;
}

.hero h1 {
  font: 700 clamp(48px, 8vw, 100px) 'Space Grotesk';
  line-height: 1.04;
  max-width: 950px;
  letter-spacing: -5px;
}

.hero h1 span, .gold { color: var(--gold); }

.hero p {
  color: var(--muted);
  max-width: 550px;
  line-height: 1.9;
  margin-top: 25px;
}

.btn {
  display: inline-block;
  padding: 15px 25px;
  background: var(--gold);
  color: #080808;
  font-weight: 800;
  border-radius: 4px;
  margin-top: 25px;
  border: none;
  cursor: pointer;
  transition: .3s;
}

.btn:hover {
  background: white;
  transform: translateY(-3px);
}

.section {
  padding: 85px 8%;
}

.heading {
  font: 700 clamp(34px, 5vw, 55px) 'Space Grotesk';
  margin-bottom: 18px;
}

.subtext {
  color: var(--muted);
  line-height: 1.8;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-top: 35px;
}

.card {
  background: var(--surface);
  border: 1px solid #292929;
  padding: 28px;
  border-radius: 8px;
  transition: .3s;
}

.card:hover {
  border-color: var(--gold);
  transform: translateY(-5px);
}

.card h3 {
  color: var(--gold);
  margin: 15px 0;
  font-family: 'Space Grotesk';
}

.card p {
  color: var(--muted);
  line-height: 1.8;
  font-size: 14px;
}

.project {
  background: var(--surface);
  border: 1px solid #292929;
  overflow: hidden;
  border-radius: 8px;
}

.project img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
  display: block;
  cursor: zoom-in;
}

.project h3 { padding: 17px; }

form {
  max-width: 720px;
  margin: 35px auto;
  background: var(--surface);
  border: 1px solid #333;
  border-radius: 10px;
  padding: 30px;
}

label {
  display: block;
  margin: 18px 0 8px;
  font-size: 14px;
  color: var(--gold);
}

input, select, textarea {
  width: 100%;
  background: #080808;
  border: 1px solid #383838;
  color: white;
  padding: 14px;
  border-radius: 5px;
  font: inherit;
  outline: none;
}

input:focus, select:focus, textarea:focus {
  border-color: var(--gold);
}

textarea {
  min-height: 130px;
  resize: vertical;
}

footer {
  text-align: center;
  padding: 30px;
  border-top: 1px solid #292929;
  color: #888;
  font-size: 13px;
}

.lightbox {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 999;
  background: rgba(0,0,0,.96);
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.lightbox img {
  max-width: 95%;
  max-height: 85vh;
  object-fit: contain;
}

.lightbox button {
  position: absolute;
  top: 15px;
  right: 25px;
  background: none;
  border: 0;
  color: var(--gold);
  font-size: 45px;
  cursor: pointer;
}

.contact-info {
  text-align: center;
  color: var(--muted);
  line-height: 2.5;
}

.contact-info a { color: var(--gold); }

@media(max-width:700px) {
  header {
    flex-direction: column;
    padding: 18px 12px;
  }

  nav {
    justify-content: center;
    gap: 13px;
  }

  nav a { font-size: 12px; }

  .hero {
    min-height: 70vh;
    padding: 75px 7%;
  }

  .hero h1 { letter-spacing: -2px; }

  .section { padding: 65px 6%; }

  form { padding: 20px; }
}
